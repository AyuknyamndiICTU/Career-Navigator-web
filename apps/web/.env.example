# =========================
# Public API URL (the API serves everything under /api)
# =========================
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api"

# =========================
# Socket.IO (optional; defaults to the origin of NEXT_PUBLIC_API_BASE_URL)
# =========================
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# =========================
# Agora (frontend config)
# =========================
NEXT_PUBLIC_AGORA_APP_ID="change-me"
