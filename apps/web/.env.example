# The browser always calls /api and /socket.io on its own origin, so the web build needs no API URL.
# Copy to apps/web/web-ui/.env.local for `npm run dev -w web-ui` (production images ignore this file).

# [optional, http://localhost:3001] where the dev server proxies /api and /socket.io
API_INTERNAL_URL="http://localhost:3001"

# Public runtime settings (e.g. the video-call app id) come from GET /api/config/public.
