# API settings for running `npm run start:dev -w api` on your machine (Docker: infra/docker/docker-compose.yml sets its own).
# [required] must be set · [optional] has the default shown or is off when empty. Read only by src/config/env.ts,
# which validates everything at boot and lists all problems at once.

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV="development"                 # [optional] development | production (production: Secure cookies, no Swagger, no log-only OTP)
PORT="3001"                            # [optional, 3000] the web dev server proxies /api to http://localhost:3001
TRUST_PROXY=""                         # [optional, 0] proxy hops in front of the API (Caddy/ingress = 1) so rate limits see client IPs
RATE_LIMIT_WINDOW_MS="60000"           # [optional, 60000]
RATE_LIMIT_MAX="200"                   # [optional, 200] requests per window per IP (login has its own 5/min limit)

# ── Auth / JWT ──────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me"          # [required] openssl rand -hex 32
JWT_REFRESH_SECRET="change-me"         # [required] a different random value
JWT_ACCESS_EXPIRES_IN="15m"            # [optional, 15m]
JWT_REFRESH_EXPIRES_IN="30d"           # [optional, 30d]
COOKIE_SECURE=""                       # [optional] Secure refresh cookie; defaults to true when NODE_ENV=production

# ── Data ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/career_navigator?schema=public"   # [required]
REDIS_URL="redis://localhost:6382"     # [optional] required when a worker below is enabled; without it AI quotas use memory

# ── Object storage (MinIO until Phase 18) ───────────────────────
MINIO_ENDPOINT="http://localhost:9000" # [required for uploads]
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="resumes"                 # [optional, resumes]
API_BASE_URL=""                        # [optional, /api] prefix for file URLs in resumes; set only if the API lives on another origin

# ── Email (OTP) ─────────────────────────────────────────────────
OTP_EMAIL_LOG_ONLY="true"              # [optional, false] true = print OTPs to the log instead of emailing (refused in production)
BREVO_API_KEY=""                       # [required unless OTP_EMAIL_LOG_ONLY=true]
BREVO_SENDER_EMAIL=""                  # [required unless OTP_EMAIL_LOG_ONLY=true]

# ── Background workers (BullMQ, need REDIS_URL) ─────────────────
CV_SCAN_ENABLED="false"                # [optional, false] parse uploaded CVs in the background (rule-based, no AI)
CV_SCAN_WORKER_CONCURRENCY="1"         # [optional, 1]
CV_DEFAULT_PHONE_COUNTRY="CM"          # [optional, CM] ISO country for CV phone numbers without a + prefix
CV_AI_ASSIST_ENABLED="true"            # [optional, true] show "Improve with AI" on low-confidence CV sections (uses the AI gateway)
CV_OCR_SERVER="false"                  # [optional, false] OCR scans on the server when the browser did not (needs an image built with WITH_OCR=true)
NOTIFICATIONS_WORKER_ENABLED="false"   # [optional, false]
NOTIFICATIONS_WORKER_CONCURRENCY="2"   # [optional, 2]

# ── AI gateway (cloud only; providers without a key are skipped) ─
GEMINI_API_KEY=""                      # [optional] free tier, primary
OLLAMA_API_KEY=""                      # [optional] Ollama Cloud (https://ollama.com/v1)
ANTHROPIC_API_KEY=""                   # [optional] no free tier: set a spend cap on the key
OPENROUTER_API_KEY=""                  # [optional]
OPENAI_API_KEY=""                      # [optional]
# [optional] provider/model chains per task, first healthy entry wins; tasks: CHAT, MOCK_INTERVIEW, CV_ASSIST, JOB_RERANK, COURSE_RECS
# AI_ROUTE_CHAT="gemini/gemini-3.8-flash,ollama/gpt-oss:120b,openrouter/openrouter/free"
AI_CHAT_TIME_BUDGET_MS="20000"         # [optional, 20000]
AI_USER_DAILY_LIMIT_CHAT="40"          # [optional] free platform requests per user per day; also _MOCK_INTERVIEW, _CV_ASSIST, _JOB_RERANK, _COURSE_RECS
AI_MODEL_DAILY_LIMITS=""               # [optional] e.g. "gemini/gemini-3.8-flash=250"
AI_PLATFORM_FREE_PROVIDERS="gemini,openrouter"   # [optional, gemini,openrouter] usage counted at $0
AI_JOB_MATCH_ENABLED="false"           # [optional, false] AI reasons on the matched-jobs page

# Users' own AI keys (Settings → AI providers)
AI_BYOK_ENABLED="false"                # [optional, false]
AI_KEY_ENCRYPTION_KEY=""               # [required when BYOK is on] 32 random bytes: openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY_PREVIOUS=""      # [optional] old key, only while rotating
AI_KEY_ENCRYPTION_KEY_VERSION="1"      # [optional, 1]
AI_BYOK_ALLOWED_HOSTS=""               # [optional] extra HTTPS hosts for OpenAI-compatible keys (private IPs always blocked)

# ── Video calling (Agora until Phase 17) ────────────────────────
AGORA_APP_ID=""                        # [optional] public; sent to browsers via GET /api/config/public
AGORA_APP_CERTIFICATE=""               # [optional] secret; needed to issue call tokens

# ── Browser access ──────────────────────────────────────────────
# [required in production] origins allowed to call the API; empty in development reflects the request origin.
CORS_ALLOWED_ORIGINS="http://localhost:3002,http://localhost:3010"

# ── API docs ────────────────────────────────────────────────────
SWAGGER_ENABLED=""                     # [optional] /api/docs; on by default outside production
SWAGGER_USER=""                        # [optional] with SWAGGER_PASSWORD: protect /api/docs with basic auth
SWAGGER_PASSWORD=""
