# =========================
# Auth / JWT
# =========================
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# =========================
# Database
# =========================
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/career_navigator?schema=public"

# =========================
# Redis
# =========================
REDIS_URL="redis://localhost:6382"

# =========================
# OpenSearch
# =========================
OPENSEARCH_URL="http://localhost:9200"
OPENSEARCH_USERNAME="admin"
OPENSEARCH_PASSWORD="change-me"

# =========================
# Object storage (MinIO)
# =========================
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="change-me"
MINIO_SECRET_KEY="change-me"
MINIO_BUCKET="resumes"

# =========================
# Email (OTP verification)
# =========================
# When true, OTP is logged to server console and NOT emailed.
OTP_EMAIL_LOG_ONLY="false"
BREVO_API_KEY="change-me"
BREVO_SENDER_EMAIL="no-reply@example.com"

# =========================
# AI gateway (cloud only — nothing runs locally)
# =========================
# Platform keys; providers without a key are skipped. Gemini's free tier is the primary.
GEMINI_API_KEY=""
OLLAMA_API_KEY=""        # Ollama Cloud (https://ollama.com/v1) only
ANTHROPIC_API_KEY=""     # no free tier: set a spend cap on the key
OPENROUTER_API_KEY=""
OPENAI_API_KEY=""
# Optional overrides: comma-separated provider/model chains per task, first healthy entry wins.
# AI_ROUTE_CHAT="gemini/gemini-3.8-flash,gemini/gemini-3.6-flash,ollama/gpt-oss:120b,anthropic/claude-haiku-5-5,openrouter/openrouter/free"
# AI_ROUTE_MOCK_INTERVIEW= / AI_ROUTE_CV_ASSIST= / AI_ROUTE_JOB_RERANK= / AI_ROUTE_COURSE_RECS=
AI_CHAT_TIME_BUDGET_MS="20000"
# Free platform AI requests per user per day (also _MOCK_INTERVIEW, _CV_ASSIST, _JOB_RERANK, _COURSE_RECS)
AI_USER_DAILY_LIMIT_CHAT="40"
# Optional per-model daily caps on platform calls, e.g. "gemini/gemini-3.8-flash=250"
AI_MODEL_DAILY_LIMITS=""
# Providers whose platform usage is free (tokens counted, cost $0)
AI_PLATFORM_FREE_PROVIDERS="gemini,openrouter"
# AI match reasons on the matched-jobs page
AI_JOB_MATCH_ENABLED="false"

# Users' own keys (Settings -> AI providers). Encryption key: 32 random bytes, `openssl rand -base64 32`.
AI_BYOK_ENABLED="false"
AI_KEY_ENCRYPTION_KEY=""
AI_KEY_ENCRYPTION_KEY_PREVIOUS=""   # only while rotating the key
AI_KEY_ENCRYPTION_KEY_VERSION="1"
# Extra HTTPS hosts allowed for OpenAI-compatible own keys (private IPs are always blocked)
AI_BYOK_ALLOWED_HOSTS=""

# =========================
# Video calling (Agora)
# =========================
AGORA_APP_ID="change-me"
AGORA_APP_CERTIFICATE="change-me"

# =========================
# CORS
# =========================
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# =========================
# Refresh-token cookie
# =========================
# Defaults to Secure when NODE_ENV=production. Set "false" only for plain-http local setups.
COOKIE_SECURE=""
