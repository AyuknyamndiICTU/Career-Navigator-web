// Rust-free Prisma 7 client, generated as TypeScript into src/ and compiled with the app (git-ignored).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  // Extensionless relative imports so Jest (ts-jest) resolves the generated .ts files.
  importFileExtension = ""
}

// The connection URL lives in prisma.config.ts (CLI) and src/prisma/prisma.service.ts (runtime adapter).
datasource db {
  provider = "postgresql"
}

enum OtpPurpose {
  REGISTER
  PASSWORD_RESET
}

enum ThemePreference {
  LIGHT
  DARK
}

enum UserRole {
  USER
  ADMIN
}

enum FeedbackStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum MediaType {
  PROFILE_PICTURE
  CV
}

enum CvScanStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum AiProvider {
  GEMINI
  OPENAI
  ANTHROPIC
  OPENROUTER
  OLLAMA_CLOUD
}

enum AiKeyTier {
  FREE
  PAID
}

enum AiCredentialStatus {
  ACTIVE
  INVALID
  DISABLED
}

enum AiCostSource {
  PROVIDER
  PRICE_TABLE
  FREE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  isActive     Boolean  @default(false)
  themePreference ThemePreference @default(LIGHT)
  role         UserRole @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deactivatedAt DateTime?

  // When the user's own AI key can't serve a request, use the platform's free AI instead.
  aiFallbackToPlatform Boolean @default(true)

  otps EmailVerificationOtp[]
  refreshTokens RefreshToken[]
  profile Profile?
  educations Education[]
  workExperiences WorkExperience[]
  projects Project[]
  references Reference[]
  media UploadMedia[]
  jobApplications JobApplication[]
  notifications Notification[]
  feedbacks Feedback[]
  conversationParticipants ConversationParticipant[]
  sentMessages Message[]
  aiCredentials UserAiCredential[]
  aiPreferences UserAiPreference[]
  aiUsageEvents AiUsageEvent[]

  @@index([createdAt])
}

model EmailVerificationOtp {
  id        String     @id @default(uuid())
  userId    String
  purpose   OtpPurpose

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?

  attempts Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  jti       String   @unique
  tokenHash String   @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique

  firstName String?
  lastName  String?
  headline  String?
  phone     String?
  location  String?
  summary   String?

  // Stores CVwizard “extra sections” (Skills/Objectives/etc.) from the UI.
  // Keep this flexible: structure is defined by the frontend.
  cvWizardData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id             String   @id @default(uuid())
  userId         String
  degree         String?
  fieldOfStudy   String?
  institution    String?
  startYear      Int?
  endYear        Int?
  grade          String?
  description    String?
  isCurrent      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WorkExperience {
  id             String   @id @default(uuid())
  userId         String
  jobTitle       String?
  company        String?
  location       String?
  startYear      Int?
  endYear        Int?
  description    String?
  isCurrent      Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  externalUrl String?
  skills      String[] @default([])
  isCurrent   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([title])
}

model Reference {
  id           String  @id @default(uuid())
  userId       String
  name         String
  relationship String?
  company      String?
  email        String?
  phone        String?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([name])
}

model UploadMedia {
  id        String   @id @default(uuid())
  userId    String
  type      MediaType
  objectKey String

  originalFilename String?
  contentType      String?

  // Milestone 2.5: CV scan orchestration (BullMQ + Ollama)
  cvScanStatus       CvScanStatus?
  cvScanRequestedAt  DateTime?
  cvScanCompletedAt  DateTime?
  cvExtractedText    String?
  cvScanError        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId, type])
  @@index([cvScanStatus])
}

enum JobStatus {
  ACTIVE
  INACTIVE
}

model Job {
  id          String     @id @default(uuid())
  title       String
  company     String
  location    String?
  description String?

  status      JobStatus  @default(ACTIVE)
  skills      String[]   @default([])
  applications JobApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Generated column (title, skills, company, description) maintained by Postgres; see migration 20261020000000_job_search.
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  // Browse lists ACTIVE jobs newest first; `skills has` filters use the GIN index.
  @@index([status, createdAt])
  @@index([skills], type: Gin)
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Job_title_trgm_idx")
  @@index([title])
  @@index([company])
  @@index([location])
}

model JobApplication {
  id           String   @id @default(uuid())
  userId       String
  jobId        String
  coverLetter  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Mentor {
  id         String   @id @default(uuid())
  displayName String
  bio        String?

  skills     String[] @default([])
  expertise  String[] @default([])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  message   String

  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String
  message   String
  status    FeedbackStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model AgoraSession {
  // Milestone 6.2: store session metadata for video calling
  sessionId   String   @id
  channelName String
  uid          BigInt
  role         String   // 'publisher' | 'subscriber'
  startedAt   DateTime @default(now())
  endedAt     DateTime?

  @@index([startedAt])
  @@index([endedAt])
}

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([createdAt])
}

model ConversationParticipant {
  id             String        @id @default(uuid())
  conversationId String
  userId         String

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model CourseScrapeCandidate {
  id          String   @id @default(uuid())
  platform    String
  title       String
  description String?
  difficulty  String?
  externalUrl String

  skills      String[] @default([])

  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([platform])
  @@index([title])
  @@index([externalUrl])
}

model CourseRecommendationCache {
  id           String   @id @default(uuid())

  userId       String
  studentGoal  String?

  allowedSkills String[] @default([])

  // Expected JSON:
  // [
  //   { platform, courseName, difficulty, description, externalUrl, whyRecommended }
  // ]
  courses      Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime?

  @@index([userId])
  @@index([expiresAt])
}

model JobScrapeCandidate {
  id          String   @id @default(uuid())
  title       String
  company     String
  location    String?
  description String?
  externalUrl String

  skills      String[] @default([])

  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company])
  @@index([title])
  @@index([externalUrl])
}

model JobRecommendationCache {
  id           String   @id @default(uuid())

  userId       String
  studentGoal  String?

  allowedSkills String[] @default([])

  // Expected JSON:
  // [
  //   { jobId, title, company, location, description, externalUrl, matchReason, score? }
  // ]
  jobs         Json

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime?

  @@index([userId])
  @@index([expiresAt])
}

// A user's own AI provider key, encrypted with AES-256-GCM (AI_KEY_ENCRYPTION_KEY never lives in the DB).
model UserAiCredential {
  id         String     @id @default(uuid())
  userId     String
  provider   AiProvider
  label      String

  ciphertext String
  iv         String
  authTag    String
  keyVersion Int        @default(1)
  last4      String

  // Only for OpenAI-compatible hosts on the admin allowlist (AI_BYOK_ALLOWED_HOSTS).
  baseUrl    String?

  tier             AiKeyTier          @default(FREE)
  monthlyBudgetUsd Decimal?           @db.Decimal(10, 2)
  status           AiCredentialStatus @default(ACTIVE)
  statusReason     String?
  lastValidatedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferences UserAiPreference[]

  @@index([userId])
}

// Which own key + model serves each AI feature for a user (no row = platform free AI).
model UserAiPreference {
  id           String  @id @default(uuid())
  userId       String
  task         String
  credentialId String
  model        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential UserAiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([userId, task])
}

// Prices per 1M tokens in USD; the newest row with effectiveFrom <= now applies.
model AiModelPrice {
  id                 String     @id @default(uuid())
  provider           AiProvider
  model              String
  inputPerMTok       Decimal    @db.Decimal(12, 6)
  outputPerMTok      Decimal    @db.Decimal(12, 6)
  cachedInputPerMTok Decimal?   @db.Decimal(12, 6)
  isFree             Boolean    @default(false)
  effectiveFrom      DateTime   @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, model, effectiveFrom])
  @@index([provider, model])
}

model AiUsageEvent {
  id              String       @id @default(uuid())
  userId          String
  // null = the platform's AI keys.
  credentialId    String?
  provider        AiProvider
  model           String
  task            String
  inputTokens     Int          @default(0)
  outputTokens    Int          @default(0)
  cachedTokens    Int          @default(0)
  reasoningTokens Int          @default(0)
  costUsd         Decimal      @default(0) @db.Decimal(12, 6)
  costSource      AiCostSource
  latencyMs       Int          @default(0)
  status          String
  createdAt       DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([credentialId, createdAt])
  @@index([createdAt])
}
