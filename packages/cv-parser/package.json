{
  "name": "@career-navigator/cv-parser",
  "version": "0.1.0",
  "private": true,
  "description": "Rule-based CV parser shared by the API worker and the web app (no AI, no DOM or Node APIs).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test \"test/*.test.mjs\"",
    "accuracy": "tsc -p tsconfig.json && node test/accuracy.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.0"
  }
}
