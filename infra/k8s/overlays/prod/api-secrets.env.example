# Copy to api-secrets.env (git-ignored) and fill in. One KEY=value per line, no quotes.
# In-cluster Postgres: user/password must match postgres.env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@cn-postgres:5432/career_navigator?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# File storage: private Cloudflare R2 bucket (token with Object Read & Write on that bucket only)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Platform AI keys (empty = provider skipped)
GEMINI_API_KEY=
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Required when AI_BYOK_ENABLED=true in the config map: openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=
# Video calls (LiveKit Cloud on Kubernetes; all three or none). Webhook: https://<site>/api/video/webhook
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
