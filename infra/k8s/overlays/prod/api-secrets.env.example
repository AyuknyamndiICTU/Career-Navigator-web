# Copy to api-secrets.env (git-ignored) and fill in. One KEY=value per line, no quotes.
# In-cluster Postgres: user/password must match postgres.env.
DATABASE_URL=postgresql://postgres:CHANGE_ME@cn-postgres:5432/career_navigator?schema=public
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Object storage (MinIO-compatible endpoint, e.g. Cloudflare R2 after Phase 18)
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# Platform AI keys (empty = provider skipped)
GEMINI_API_KEY=
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# Required when AI_BYOK_ENABLED=true in the config map: openssl rand -base64 32
AI_KEY_ENCRYPTION_KEY=
# Video calling (Agora until Phase 17)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
