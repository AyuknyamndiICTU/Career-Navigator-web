# One origin for the browser: /api and /socket.io go to the API, everything else to the web app.
# SITE_ADDRESS=":80" serves plain HTTP (local); a domain name (e.g. app.example.com) gets automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api /api/* /socket.io /socket.io/*
	handle @api {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:3000
	}
}
