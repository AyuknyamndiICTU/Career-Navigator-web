# Copy to `.env` next to docker-compose.yml on the server (e.g. /opt/career-navigator/.env) and fill in.
# Never commit the real file. Generate secrets with: openssl rand -hex 32
# Use URL-safe values (hex) for passwords that end up inside connection URLs.
# Empty [required] values abort `docker compose up` with a message naming the variable.

# Public domain, e.g. careers.example.com (DNS A/AAAA record -> this server). [required]
# Caddy serves it over HTTPS with automatic Let's Encrypt certificates and routes /api + /socket.io to the API.
SITE_ADDRESS=

# Images (set by the Jenkins deploy; TAG is the git commit SHA)
DOCKERHUB_USER=your_dockerhub_username
TAG=

# Postgres [required]. POSTGRES_PASSWORD only initialises a NEW volume; on an existing volume change it first with:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new>'"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=career_navigator

# [required]
REDIS_PASSWORD=

# Object storage (MinIO until Phase 18) [required]
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=resumes

# [required] two different random values
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# [optional, https://$SITE_ADDRESS] comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=

# OTP email [required]
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Platform AI (cloud only; providers without a key are skipped). Gemini's free tier is the primary.
GEMINI_API_KEY=
OLLAMA_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
AI_JOB_MATCH_ENABLED=false
# Free platform AI requests per user per day (per feature: CHAT, MOCK_INTERVIEW, CV_ASSIST, JOB_RERANK, COURSE_RECS)
AI_USER_DAILY_LIMIT_CHAT=40

# Let users add their own AI keys. The encryption key must be 32 random bytes: openssl rand -base64 32
# Keep it safe: without it stored user keys can't be decrypted. During a rotation put the old one in _PREVIOUS.
AI_BYOK_ENABLED=false
AI_KEY_ENCRYPTION_KEY=
AI_KEY_ENCRYPTION_KEY_PREVIOUS=

# Video calling (Agora until Phase 17) [optional]; the app id is public, the certificate is secret.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# API docs at https://$SITE_ADDRESS/api/docs [optional, off]. If enabled, set both credentials (basic auth).
SWAGGER_ENABLED=false
SWAGGER_USER=
SWAGGER_PASSWORD=
