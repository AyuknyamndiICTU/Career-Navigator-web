# Copy to `.env` next to docker-compose.yml on the server (e.g. /opt/career-navigator/.env) and fill in.
# Never commit the real file. Generate secrets with: openssl rand -hex 32
# Use URL-safe values (hex) for passwords that end up inside connection URLs.

# Images
DOCKERHUB_USER=your_dockerhub_username
TAG=latest

# Postgres. POSTGRES_PASSWORD only initialises a NEW volume; on an existing volume change it first with:
#   docker compose exec postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<new>'"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=career_navigator

REDIS_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=resumes

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated browser origins allowed to call the API (e.g. https://yourdomain.com)
CORS_ALLOWED_ORIGINS=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Optional AI providers
GEMINI_API_KEY=
OLLAMA_API_KEY=
